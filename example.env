DSW_VERSION=4.29

# Versions of dependencies (see their docs)
# Upgrades may require migrations.
POSTGRES_VERSION=17.5
GARAGE_VERSION=v2.2.0

# Template for generating .env with ./scripts/bootstrap_env.py.
# Update the public URLs for your environment before generating .env.
# Use <auto> for generated values and <derived> for values built from other settings.
# Leaving them blank still works, but placeholders make the intent easier to read.
# DSW application configuration injected via docker-compose.yml environment variables.
CLIENT_URL=http://localhost:8080/wizard
CLIENT_API_URL=http://localhost:3000/wizard-api
GENERAL_SECRET=<auto>

# PostgreSQL configuration.
POSTGRES_USER=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=<auto>
POSTGRES_DB=engine-wizard
DATABASE_CONNECTION_STRING=<derived>

# DSW S3 configuration.
# Use a host IP or DNS name reachable from both the browser and the containers.
S3_URL=#Please modify this URL to point to your S3-compatible storage. For example, http://{your_ip}:9000
S3_USERNAME=<auto>
S3_PASSWORD=<auto>
S3_BUCKET=engine-wizard
S3_REGION=garage

# SMTP / mail configuration.
MAIL_ENABLED=false
MAIL_NAME=
MAIL_EMAIL=
MAIL_PROVIDER=smtp
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=25
MAIL_SMTP_SECURITY=plain
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

# Garage daemon secrets.
# Change these defaults before sharing or reusing this setup.
GARAGE_ADMIN_URL=http://garage:3903/v2
GARAGE_ZONE=dc1
GARAGE_CAPACITY=1G
GARAGE_KEY_NAME=dsw-engine-wizard
GARAGE_RPC_SECRET=<auto>
GARAGE_ADMIN_TOKEN=<auto>
GARAGE_METRICS_TOKEN=<auto>
